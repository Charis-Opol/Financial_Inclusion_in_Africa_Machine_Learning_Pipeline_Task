\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Group DRO and its comparators: five-seed means of pooled PR-AUC ($P$), worst-country PR-AUC ($W$) and per-country PR-AUC. $W$ always equals Rwanda's PR-AUC here (Rwanda is the worst country for every arm), so the two columns are identical; Rwanda is repeated for easy comparison with Kenya, Tanzania and Uganda in the same row. Kenya is the country Group DRO concentrates its weight $q$ on (Figure~\ref {fig:q}); its PR-AUC barely moves even as $q_{\text  {Kenya}}$ rises to 0.91 under \texttt  {mlp\_dro}.}}{13}{table.caption.17}\protected@file@percent }
\newlabel{tab:e3}{{5}{13}{Group DRO and its comparators: five-seed means of pooled PR-AUC ($P$), worst-country PR-AUC ($W$) and per-country PR-AUC. $W$ always equals Rwanda's PR-AUC here (Rwanda is the worst country for every arm), so the two columns are identical; Rwanda is repeated for easy comparison with Kenya, Tanzania and Uganda in the same row. Kenya is the country Group DRO concentrates its weight $q$ on (Figure~\ref {fig:q}); its PR-AUC barely moves even as $q_{\text {Kenya}}$ rises to 0.91 under \arm {mlp\_dro}}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Paired differences with 95\% bootstrap intervals. Intervals for $W$ can be asymmetric because the worst country can change between replicates.}}{14}{table.caption.18}\protected@file@percent }
